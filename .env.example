# ==============================================================================
# Vantrilex Assistant OS — Environment Configuration Template
# Copy to .env and fill in. NEVER commit .env.
# Two processes read this file: CORE (runs in the HF Space, ADR-15) and BRIDGE
# (runs on the Windows PC). Each block lists where to obtain every value.
# ==============================================================================

# ------------------------------------------------------------------------------
# [CORE] AI Brain — OmniRoute gateway (co-located with core in the HF Space)
# Obtain: install OmniRoute beside the core (https://github.com/diegosouzapw/OmniRoute),
# configure its free provider pools, keep it bound to localhost. In production the
# values below load from HF Secrets (never git).
# ------------------------------------------------------------------------------
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=sk-omniroute-local-key
# 3-tier brain (ADR-16) behind the Fast Front-Door Dispatcher (ADR-18):
# Fallbacks are comma-separated and walked left-to-right within the tier.
# Live bake-off 2026-08-30 (7 candidates, same persona prompt): Gemini retired
# (Google walls the project behind billing). Roles per owner: FAST = Sara's
# voice (talker; instant + Jordanian), MEDIUM = worker (Obsidian CRUD + task
# executor — gpt-oss-120b, pinned when triage lands; chat leg shares the
# talker voice), HEAVY = deep reasoning. gpt-oss-20b: only candidate near the
# <250ms promise (0.5s TTFT) with clean Jordanian; minimax-m3 (owner upgrade
# 2026-09-03): strongest Arabic-dialect speaker in the free pool, live-probed
# via OmniRoute (~4.8s first token). OpenRouter :free pool = 50 req/day/account.
# Tier 1 FAST — conversation + instant ack (<250ms) + routing
FAST_MODEL=groq/openai/gpt-oss-120b
FAST_MODEL_FALLBACKS=google/gemma-4-31b-it:free
# 2026-09-14: groq is primary (owner strategic pivot; measured ~0.6s cold TTFT
# vs the hop-stalled gemma). Gemma stays secondary behind the 4s first-token
# guillotine + 15m quarantine (fail-fast, no 3-minute stalls). 2026-09-13
# context preserved: sustained unannounced 429 episodes trip a 15m quarantine
# after 2 consecutive hits, and empty streams park the model 15m too.
# Tier 2 MEDIUM — sub-agent fleet workers (isolated tool actions, scrapes, data)
# `openrouter/` prefix is required, not decorative: the bare `nex-agi/...` slug 404s
# (see the Tier 3 note below for the full measurement).
MEDIUM_MODEL=openrouter/nex-agi/nex-n2.5-mini:free
MEDIUM_MODEL_FALLBACKS=groq/openai/gpt-oss-120b
# Tier 3 HEAVY base (<= threshold concurrent tasks): master orchestrator (397B).
# 2026-09-30 re-pin: the BARE `nex-agi/...` slug FORM does not route. The gateway's
# /models lists both of these models under the `openrouter/` provider, so the bare
# form resolves to nothing and 404s ("No active credentials for provider: nex-agi").
# It was never a dead pool and never missing credentials — the slug form was the
# defect, and the tier paid a wasted round trip on every turn before falling back.
# The provider-prefixed form is the working pin. Historical note kept (2026-09-13):
# the first reading of that 404 was "nex-agi has no live provider credentials", and
# the chain was parked on nemotron MoE then groq. Two things that re-pin did NOT
# change: model-level 4xx (400/404/422) still falls through instead of aborting
# (401/403 still abort: gateway suspect), and bare-429 streaks (>2 consecutive
# unannounced) still quarantine the model 15m (fail-fast).
HEAVY_MODEL=openrouter/nex-agi/nex-n2.5-pro:free
HEAVY_MODEL_FALLBACKS=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free,groq/openai/gpt-oss-120b
# HEAVY auto-escalation (> threshold tasks or complex DAG swarms): 550B MoE
HEAVY_ESCALATION_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
HEAVY_ESCALATION_FALLBACKS=groq/openai/gpt-oss-120b
HEAVY_CONCURRENCY_THRESHOLD=3

# ------------------------------------------------------------------------------
# [CORE] Telegram — bot + owner identity
# BOT TOKEN:   talk to @BotFather on Telegram  -> /newbot
# OWNER ID:    message @userinfobot             -> copy your numeric ID
# API_ID/HASH: https://my.telegram.org          -> API development tools
#              (required from v1.1 for PyTgCalls live calling)
# SESSION:     Telethon/Pyrogram session string (v1.1, live calls only)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
AUTHORIZED_USER_ID=123456789
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION_STRING=
# v2.0 pass-4: YouTube Data API v3 key (free 10k units/day quota; empty = tool
# stays honestly offline until the owner drops the key in)
YOUTUBE_API_KEY=
# M3 (2026-09-05 §2): the PC's MAC address — /start_station's Wake-on-LAN
# target (find it: Settings > Network > adapter hardware properties)
PC_MAC_ADDRESS=
# M4 (2026-09-05 §4): ExchangeRate pair API key (free tier; empty = the
# currency tool stays honestly offline)
EXCHANGERATE_API_KEY=
# v2.0 pass-4 (§7 staged): Instagram session string — the sandbox surface is
# fully built; the live transport binds the day this is filled (instagrapi)
INSTAGRAM_SESSION=
# v2.0 pass-4 (§7 staged): Firecrawl key (free tier) — complex-page Markdown
# extraction; empty = the keyless WebIntel.read_page path serves page reads
FIRECRAWL_API_KEY=
# Chat streaming (task 2.2): minimum gap between bubble edits, in milliseconds.
STREAM_EDIT_INTERVAL_MS=750

# ------------------------------------------------------------------------------
# [CORE] Voice engine — Fish Audio is Sara's ONLY voice (owner directive 2026-09-03 07:03):
# fish s2.1-pro-free + the «سمسم-بوس» reference voice via OpenRouter's speech
# API (/api/v1/audio/speech), borrowing the same OPENROUTER_API_KEY free pool
# already feeding OmniRoute. NO Microsoft fallback: a Fish failure lands the
# honest TEXT reply (voice identity stays pure). Leave OPENROUTER_API_KEY
# empty -> pure local Edge-TTS (Salma) for unconfigured deployments only.
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-key
# Credential separation (2026-09-13): the voice lane prefers its own
# FISH_AUDIO_API_KEY and falls back to OPENROUTER_API_KEY when empty.
FISH_AUDIO_API_KEY=
# Speech surface: OpenRouter speech (default) or the direct Fish API
# (https://api.fish.audio/v1/tts).
FISH_AUDIO_ENDPOINT=https://openrouter.ai/api/v1/audio/speech
FISH_AUDIO_MODEL=fish-audio/s2.1-pro-free:free
FISH_AUDIO_VOICE_REF=56c2f0c23924449781863ff20aceb5fa
# Calm-tone pace multiplier (officially supported by /audio/speech — "only used
# by models that support it"): the temperature-0.7 steadiness emulation. 1.0 =
# provider default.
FISH_AUDIO_SPEED=0.9
# Fallback lane — Edge-TTS (free, local synthesis): Jordanian Arabic neural
# voice; picks up automatically on ANY Fish failure (402/429/timeout/garbage).
VOICE_NAME=ar-EG-SalmaNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

# ------------------------------------------------------------------------------
# [CORE] Knowledge vault — git-backed Obsidian repository
# Obtain: create a private GitHub repo for the vault, generate a fine-grained
# PAT (repo scope) at github.com/settings/tokens.
# VAULT_LOCAL_PATH roots all durable state (ADR-15); VAULT_ENC_KEY seals every
# secret at rest (Fernet). Generate the key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------------------------
VAULT_LOCAL_PATH=./vault
VAULT_ENC_KEY=generate_a_long_random_fernet_key
VAULT_GITHUB_REPO=owner/vault-repo
# Required from sprint-3 (task 3.1): the core writes via the GitHub Contents API.
VAULT_GITHUB_TOKEN=
VAULT_BRANCH=main

# ------------------------------------------------------------------------------
# [CORE] Gmail polling + tiered triage tuning (sprint-2 §2.1/§2.4)
# GMAIL_PUBSUB_TOPIC empty -> polling only. Keyword lists empty -> built-in
# defaults. CRITICAL_PING_MAX 0 = unlimited until the owner acknowledges.
# TOKENJUICE_MAX_CHARS caps the compacted body fed to scoring + refinement (ADR-19).
# ------------------------------------------------------------------------------
GMAIL_PUBSUB_TOPIC=
GMAIL_POLL_SECONDS=120
GMAIL_SWEEP_DAYS=2
TRIAGE_BODY_MAX_CHARS=8000
GOOGLE_VIP_SENDERS=
TRIAGE_KEYWORDS_AR=
TRIAGE_KEYWORDS_EN=
CRITICAL_PING_INTERVAL_MIN=5
CRITICAL_PING_MAX=6
TOKENJUICE_MAX_CHARS=4000

# ------------------------------------------------------------------------------
# [CORE] Google Workspace — Calendar, Gmail, Drive, Contacts, Tasks
# Obtain: console.cloud.google.com -> new project -> enable Calendar/Gmail/
# Drive/Tasks APIs -> OAuth consent screen (External, test user = you) ->
# Credentials -> OAuth client ID (Desktop app) -> download JSON to
# config/google_oauth_client.json (gitignored). First run opens a browser
# for consent; the refresh token is cached locally on the VPS.
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_JSON=./config/google_oauth_client.json
GOOGLE_CALENDAR_ID=primary

# ------------------------------------------------------------------------------
# [CORE <-> BRIDGE] PC link — outbound-only tunnel
# The PC daemon dials OUT to the core over TLS WebSocket; no inbound ports on
# the PC. Both sides share BRIDGE_TOKEN. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# CORE side: the public WSS endpoint the core serves.
# ------------------------------------------------------------------------------
BRIDGE_TOKEN=your_generated_bridge_token
# The core serves this WSS endpoint on its single public port (ADR-15); the BRIDGE
# daemon dials OUT to it. The daemon's only LISTENING surface is the LAN port below.
BRIDGE_SERVER_URL=wss://your-space-host/bridge
BRIDGE_LAN_PORT=8000
# Public Space root (deploy smoke + keep-alive target; unset for local runs).
SPACE_URL=

# ------------------------------------------------------------------------------
# [RUNTIME] Misc
# ------------------------------------------------------------------------------
TZ=Asia/Amman
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# [CORE] Daily brief — one Jordanian-Arabic digest per day (sprint-2 §2.4)
# BRIEF_LOCAL_TIME is the local (TZ) fire time, 24h HH:MM. Events + tasks due
# today + mail picture. Disabling sends nothing (BRIEF_ENABLED=false).
# ------------------------------------------------------------------------------
BRIEF_ENABLED=true
BRIEF_LOCAL_TIME=07:30

# ------------------------------------------------------------------------------
# [CORE] Evening journaler (sprint-2 §2.6) — daily ledger + ONE proactive
# check-in at a randomized moment inside [JOURNALER_WINDOW_START,
# JOURNALER_WINDOW_END), local (TZ) 24h HH:MM. Skipped when the calendar shows
# you busy (the ledger still lands). Disabling sends nothing and writes nothing
# (JOURNALER_ENABLED=false).
# ------------------------------------------------------------------------------
JOURNALER_ENABLED=true
JOURNALER_WINDOW_START=18:00
JOURNALER_WINDOW_END=19:30
DAILY_LOGS_DIR=Daily_Logs

# ------------------------------------------------------------------------------
# [CORE] Proactive outreach (remediation 3.2, owner directive 3) — Sara
# INITIATES: a smart loop asks the HEAVY model (nemotron) whether the day's
# context deserves a warm check-in to the owner. Hard bounds: only inside
# [PROACTIVE_WINDOW_START, PROACTIVE_WINDOW_END] local, at most
# PROACTIVE_MAX_PER_DAY sends, at least PROACTIVE_COOLDOWN_MIN minutes apart,
# never when the calendar shows you busy, never claims actions.
# PROACTIVE_ENABLED=false silences the axis entirely.
# ------------------------------------------------------------------------------
PROACTIVE_ENABLED=true
PROACTIVE_INTERVAL_MIN=45
PROACTIVE_MAX_PER_DAY=3
PROACTIVE_WINDOW_START=08:00
PROACTIVE_WINDOW_END=22:30
PROACTIVE_COOLDOWN_MIN=45


# ------------------------------------------------------------------------------
# [CORE] Voice biometrics (ADR-17, sprint-2 §2.3) — second trust factor for
# voice notes: ECAPA-TDNN speaker embedding (FOSS, local CPU). Enrollment is
# opt-in via /enroll-voice; below-threshold voice -> Guest Mode lockdown.
# ------------------------------------------------------------------------------
VOICEPRINT_THRESHOLD=0.60
VOICEPRINT_MODEL=speechbrain/spkrec-ecapa-voxceleb

# ------------------------------------------------------------------------------
# [CORE] Voice-to-vault transcriber (sprint-2 §2.5) — LOCAL faster-whisper
# (MIT, CPU); never cloud STT (settled ruling). First run downloads the model
# into the local cache — RUNBOOK warmup step. tiny/base/small/medium.
# ------------------------------------------------------------------------------
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
VOICE_MEMOS_DIR=Voice_Memos
