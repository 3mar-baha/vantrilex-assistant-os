# ==============================================================================
# Vantrilex Assistant OS — Environment Configuration Template
# Copy to .env and fill in. NEVER commit .env.
# Two processes read this file: CORE (runs in the HF Space, ADR-15) and BRIDGE
# (runs on the Windows PC). Each block lists where to obtain every value.
# ==============================================================================

# ------------------------------------------------------------------------------
# [CORE] AI Brain — OmniRoute gateway (co-located with core in the HF Space)
# Obtain: install OmniRoute beside the core (https://github.com/diegosouzapw/OmniRoute),
# configure its free provider pools, keep it bound to localhost. In production the
# values below load from HF Secrets (never git).
# ------------------------------------------------------------------------------
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=sk-omniroute-local-key
# 3-tier brain (ADR-16) behind the Fast Front-Door Dispatcher (ADR-18):
# Fallbacks are comma-separated and walked left-to-right within the tier.
# Live bake-off 2026-08-30 (7 candidates, same persona prompt): Gemini retired
# (Google walls the project behind billing). Roles per owner: FAST = Sara's
# voice (talker; instant + Jordanian), MEDIUM = worker (Obsidian CRUD + task
# executor — gpt-oss-120b, pinned when triage lands; chat leg shares the
# talker voice), HEAVY = deep reasoning. gpt-oss-20b: only candidate near the
# <250ms promise (0.5s TTFT) with clean Jordanian; minimax-m2.7 = warm dialect
# backup (~2.2s openrouter queue). OpenRouter :free pool = 50 req/day/account.
# Tier 1 FAST — instant ack + routing
FAST_MODEL=groq/openai/gpt-oss-20b
FAST_MODEL_FALLBACKS=openrouter/minimax/minimax-m2.7:free
# Tier 2 MEDIUM — chat leg speaks with the same voice; worker model joins when
# task 2.3 lands
MEDIUM_MODEL=groq/openai/gpt-oss-20b
MEDIUM_MODEL_FALLBACKS=openrouter/minimax/minimax-m2.7:free,groq/openai/gpt-oss-120b
# Tier 3 HEAVY — chained DAG planning, tutoring, syllabus PDF-to-DAG, deep coding
HEAVY_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
HEAVY_MODEL_FALLBACKS=groq/openai/gpt-oss-120b

# ------------------------------------------------------------------------------
# [CORE] Telegram — bot + owner identity
# BOT TOKEN:   talk to @BotFather on Telegram  -> /newbot
# OWNER ID:    message @userinfobot             -> copy your numeric ID
# API_ID/HASH: https://my.telegram.org          -> API development tools
#              (required from v1.1 for PyTgCalls live calling)
# SESSION:     Telethon/Pyrogram session string (v1.1, live calls only)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
AUTHORIZED_USER_ID=123456789
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USER_SESSION_STRING=
# Chat streaming (task 2.2): minimum gap between bubble edits, in milliseconds.
STREAM_EDIT_INTERVAL_MS=750

# ------------------------------------------------------------------------------
# [CORE] Voice engine — Edge-TTS (free, local synthesis)
# Voice fixed to Jordanian Arabic neural voice; rate/pitch tunable.
# ------------------------------------------------------------------------------
VOICE_NAME=ar-JO-SanaNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

# ------------------------------------------------------------------------------
# [CORE] Knowledge vault — git-backed Obsidian repository
# Obtain: create a private GitHub repo for the vault, generate a fine-grained
# PAT (repo scope) at github.com/settings/tokens. OBSIDIAN_REST_API_URL/KEY are
# optional (used only when the vault also runs behind obsidian-local-rest-api).
# VAULT_LOCAL_PATH roots all durable state (ADR-15); VAULT_ENC_KEY seals every
# secret at rest (Fernet). Generate the key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------------------------
VAULT_LOCAL_PATH=./vault
VAULT_ENC_KEY=generate_a_long_random_fernet_key
VAULT_GITHUB_REPO=owner/vault-repo
# Required from sprint-3 (task 3.1): the core writes via the GitHub Contents API.
VAULT_GITHUB_TOKEN=
VAULT_BRANCH=main
OBSIDIAN_REST_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=

# ------------------------------------------------------------------------------
# [CORE] Gmail polling + tiered triage tuning (sprint-2 §2.1/§2.4)
# GMAIL_PUBSUB_TOPIC empty -> polling only. Keyword lists empty -> built-in
# defaults. CRITICAL_PING_MAX 0 = unlimited until the owner acknowledges.
# TOKENJUICE_MAX_CHARS caps the compacted body fed to scoring + refinement (ADR-19).
# ------------------------------------------------------------------------------
GMAIL_PUBSUB_TOPIC=
GMAIL_POLL_SECONDS=120
GMAIL_SWEEP_DAYS=2
TRIAGE_BODY_MAX_CHARS=8000
GOOGLE_VIP_SENDERS=
TRIAGE_KEYWORDS_AR=
TRIAGE_KEYWORDS_EN=
CRITICAL_PING_INTERVAL_MIN=5
CRITICAL_PING_MAX=6
TOKENJUICE_MAX_CHARS=4000

# ------------------------------------------------------------------------------
# [CORE] Google Workspace — Calendar, Gmail, Drive, Contacts, Tasks
# Obtain: console.cloud.google.com -> new project -> enable Calendar/Gmail/
# Drive/Tasks APIs -> OAuth consent screen (External, test user = you) ->
# Credentials -> OAuth client ID (Desktop app) -> download JSON to
# config/google_oauth_client.json (gitignored). First run opens a browser
# for consent; the refresh token is cached locally on the VPS.
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_JSON=./config/google_oauth_client.json
GOOGLE_CALENDAR_ID=primary
# GCP project holding the enabled APIs (Calendar/Gmail/Drive/Tasks/Contacts)
GOOGLE_CLOUD_PROJECT=

# ------------------------------------------------------------------------------
# [CORE <-> BRIDGE] PC link — outbound-only tunnel
# The PC daemon dials OUT to the core over TLS WebSocket; no inbound ports on
# the PC. Both sides share BRIDGE_TOKEN. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# CORE side: the public WSS endpoint the core serves.
# BRIDGE side: the same URL + the PC's NIC identifiers for Wake-on-LAN.
# ------------------------------------------------------------------------------
BRIDGE_TOKEN=your_generated_bridge_token
# The core serves this WSS endpoint on its single public port (ADR-15); the BRIDGE
# daemon dials OUT to it. The daemon's only LISTENING surface is the LAN port below.
BRIDGE_SERVER_URL=wss://your-space-host/bridge
BRIDGE_LAN_PORT=8000
TARGET_PC_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
TARGET_PC_IP=192.168.1.100
TARGET_PC_WOL_PORT=9

# ------------------------------------------------------------------------------
# [RUNTIME] Misc
# ------------------------------------------------------------------------------
TZ=Asia/Amman
LOG_LEVEL=INFO
IDLE_SHUTDOWN_MINUTES=20

# ------------------------------------------------------------------------------
# [CORE] Daily brief — one Jordanian-Arabic digest per day (sprint-2 §2.4)
# BRIEF_LOCAL_TIME is the local (TZ) fire time, 24h HH:MM. Events + tasks due
# today + mail picture. Disabling sends nothing (BRIEF_ENABLED=false).
# ------------------------------------------------------------------------------
BRIEF_ENABLED=true
BRIEF_LOCAL_TIME=07:30

# ------------------------------------------------------------------------------
# [CORE] Evening journaler (sprint-2 §2.6) — daily ledger + ONE proactive
# check-in at a randomized moment inside [JOURNALER_WINDOW_START,
# JOURNALER_WINDOW_END), local (TZ) 24h HH:MM. Skipped when the calendar shows
# you busy (the ledger still lands). Disabling sends nothing and writes nothing
# (JOURNALER_ENABLED=false).
# ------------------------------------------------------------------------------
JOURNALER_ENABLED=true
JOURNALER_WINDOW_START=18:00
JOURNALER_WINDOW_END=19:30
DAILY_LOGS_DIR=Daily_Logs


# ------------------------------------------------------------------------------
# [CORE] Voice biometrics (ADR-17, sprint-2 §2.3) — second trust factor for
# voice notes: ECAPA-TDNN speaker embedding (FOSS, local CPU). Enrollment is
# opt-in via /enroll-voice; below-threshold voice -> Guest Mode lockdown.
# ------------------------------------------------------------------------------
VOICEPRINT_THRESHOLD=0.75
VOICEPRINT_MODEL=speechbrain/spkrec-ecapa-voxceleb

# ------------------------------------------------------------------------------
# [CORE] Voice-to-vault transcriber (sprint-2 §2.5) — LOCAL faster-whisper
# (MIT, CPU); never cloud STT (settled ruling). First run downloads the model
# into the local cache — RUNBOOK warmup step. tiny/base/small/medium.
# ------------------------------------------------------------------------------
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=int8
VOICE_MEMOS_DIR=Voice_Memos
