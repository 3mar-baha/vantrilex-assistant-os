      "profile_files": [
        "02_Areas/Profile/User_Info.md",
        "02_Areas/Profile/Dialect_Notes.md"
      ]
    },
    "mcp_servers": [
      "google_workspace_mcp",
      "obsidian_mcp",
      "windows_mcp"
    ]
  }
