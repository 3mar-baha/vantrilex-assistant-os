{
  "agent": {
    "name": "Sara (سارة)",
    "dialect": "ar-JO",
    "voice": "ar-JO-SanaNeural",
    "personality": "Warm, executive, polymath tutor (10 languages & sciences), supportive friend; affectionate banter, strictly no romantic roleplay",
    "brain": {
      "gateway": "omniroute",
      "primary_model": "gemini/gemini-3.7-flash",
      "fast_model": "gemini/gemini-3.5-flash-lite"
    },
    "auth": {
      "owner_allowlist": "AUTHORIZED_USER_ID",
      "voice_biometrics": {
        "engine": "speechbrain-ecapa-tdnn",
        "fallback": "resemblyzer",
        "similarity_threshold_env": "VOICE_SIMILARITY_THRESHOLD",
        "guest_mode": "greeting + zero-trust lockdown + message-taking"
      }
    },
    "vault": {
      "mandatory_dirs": [
        "Contacts",
        "Call_Transcripts",
        "Studies",
        "Voice_Memos",
        "Daily_Logs"
      ],
      "profile_files": [
        "02_Areas/Profile/User_Info.md",
        "02_Areas/Profile/Dialect_Notes.md"
      ]
    },
    "mcp_servers": [
      "google_workspace_mcp",
      "obsidian_mcp",
      "windows_mcp"
    ]
  }
}
