data/

# ADR-15 vault-mirror runtime state (src/vault.py LOCAL_SCAFFOLD_DIRS) -- owner
# data that is regenerable but must never be staged. Added 2026-09-30: P3-A
# began writing State/evolution_backlog.jsonl at runtime, and nothing tracked
# anything under State/, so the rule is safe. src/task_orchestrator.py already
# wrote reminder state here while its AC6 justification claimed this path was
# ignored -- it was not.
State/

# Local working copy of the git-backed Obsidian vault (owner data — never commit)
vault/

# Ephemeral tool dumps — never commit (audit 2026-09-16)
compile.txt
ruff_out.txt

# sara.ps1 boot transcripts — local diagnostics, never commit
logs/

